# GEMINI_API_KEY: Required for Gemini AI text generation and analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Shared Cloud Audio Library — Server-Side Secrets (configure in AI Studio Secrets panel)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""
TOKEN_ENCRYPTION_KEY=""
APP_ADMIN_EMAIL="hmixer1204.2.2@gmail.com"

# Optional: Google Workspace Shared Drive Service Account (only for Workspace Shared Drives, not personal My Drive)
# GOOGLE_SERVICE_ACCOUNT_JSON=""
# GOOGLE_SHARED_DRIVE_ID=""

# Optional: Google Cloud Text-to-Speech API key
# GOOGLE_CLOUD_TTS_API_KEY="YOUR_GOOGLE_CLOUD_API_KEY"
